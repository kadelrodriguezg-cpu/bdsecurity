# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
#
# Para desarrollo LOCAL, estos valores los imprime `supabase start` en la consola.
# Para PRODUCCIÓN, los sacas del dashboard de tu proyecto en supabase.com
# (Settings -> API).

# URL de la API de tu proyecto Supabase.
SUPABASE_URL=http://127.0.0.1:54600

# Clave pública "anon". Respeta el RLS. Es la que usa la app. Puede ir al frontend.
SUPABASE_ANON_KEY=

# Clave "service_role". SALTEA el RLS. SOLO para scripts de administración del
# lado del servidor. NUNCA la pongas en el frontend ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SENTRY_DSN=