{
  "name": "dbsecurity-frutales",
  "version": "0.1.0",
  "description": "Backend base del sistema de trazabilidad genetica de frutales (Supabase + TypeScript).",
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "types:gen": "supabase gen types typescript --local > src/types/database.types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@sentry/react": "^10.64.0",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "supabase": "^2.109.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "file:../../tinyexec@1.2.4/node_modules/tinyexec": true,
    "file:../../lightningcss@1.32.0/node_modules/lightningcss": true
  }
}
